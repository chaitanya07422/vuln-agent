# Copy to .env for local overrides
VULN_AGENT_CONFIG=config/default.yaml
VULN_AGENT_HOST=0.0.0.0
VULN_AGENT_PORT=8000
# Leave empty for in-memory store; set for Mongo
# VULN_AGENT_MONGO_URI=mongodb://localhost:27017
# Set with Mongo to enqueue scans to ARQ workers (otherwise in-process)
# VULN_AGENT_REDIS_URL=redis://localhost:6379
# Comma-separated browser origins for the separate web app
VULN_AGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://vulscan.duckdns.org
VULN_AGENT_FRONTEND_URL=http://localhost:3000
VULN_AGENT_JWT_SECRET=change-me-in-production

# Google OAuth (reuse JobPilot client; add ScanLead redirect URIs in Google Console)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Prefer same-origin via Next rewrite so refresh cookie is first-party:
# GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback
# Production: https://vulscan.duckdns.org/v1/auth/google/callback
# VULN_AGENT_COOKIE_SECURE=true

# Razorpay (Phase D — optional until configured)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Optional LLM keys (scans work without them; Adapt/Reporter use heuristics/templates)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# VULN_AGENT_CLAUDE_MODEL=claude-3-5-haiku-latest
# VULN_AGENT_OPENAI_MODEL=gpt-4o-mini
# VULN_AGENT_GEMINI_MODEL=gemini-flash-latest

